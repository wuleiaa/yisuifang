# =============================================================================
#  医院随访管理系统 · 环境变量模板
#  用法：
#    1. 复制本文件为 .env           cp .env.example .env
#    2. 把所有 CHANGE_ME 替换成随机值
#    3. .env 绝对不能提交到 Git（已在 .gitignore 中排除）
#
#  生成随机密钥的三种方式（任选其一）：
#    Linux:   openssl rand -base64 32
#    Windows: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#    Docker:  docker run --rm alpine/openssl rand -base64 32
# =============================================================================

# ------------------------------------------------------------------ 数据库
DB_NAME=followup

# 超级用户：仅用于初始化、备份、维护；应用不得使用
# 注意：名字不能以 pg_ 开头 —— PostgreSQL 把 pg_ 前缀留给系统角色，
# 用 pg_admin 会导致 initdb 直接拒绝启动。
DB_SUPERUSER=followup_admin
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

# 应用账号：必须是普通用户，行级安全策略依赖这一点
DB_APP_USER=app_rw
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# ------------------------------------------------------------------ 缓存
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ------------------------------------------------------------------ 数据加密密钥
# ⚠️ 一旦上线，这两个值绝对不能修改，否则已加密的手机号/身份证将无法解密。
# ⚠️ 必须单独备份（建议抄写在纸上锁进抽屉，或存入医院密码保险柜）。
APP_CRYPTO_DATA_KEY=CHANGE_ME_BASE64_32_BYTES
APP_CRYPTO_HASH_PEPPER=CHANGE_ME_ANOTHER_BASE64_32_BYTES

# JWT 签名密钥：不配这一项，容器会直接拒绝启动（故意的）。
# 代码里的默认值是开发用的公开串，生产漏配等于任何人都能伪造登录令牌。
APP_JWT_SECRET=CHANGE_ME_BASE64_32_BYTES

# ------------------------------------------------------------------ 域名与网络
# 部署到服务器时改成真实域名；本机演示用 localhost
SERVER_NAME=localhost

# ------------------------------------------------------------------ 应用镜像
APP_IMAGE=followup/app:latest

# ------------------------------------------------------------------ 备份
BACKUP_KEEP_DAYS=30

# ------------------------------------------------------------------ 微信（未启用可留空）
# 小程序（患者端与医护端提醒渠道之一）
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# 服务号（医院已有；订阅通知需先申请模板）
WECHAT_OA_APPID=
WECHAT_OA_SECRET=
