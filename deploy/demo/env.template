# =============================================================================
#  演示环境配置模板
#
#  用法：
#    1. 复制本文件为 .env          cp env.template .env
#    2. 把下面 6 个 CHANGE_ME 换成随机密码（生成方法见"新手部署指南"第八节）
#    3. 绝对不能把 .env 发到群里或提交到代码仓库
# =============================================================================

# ------------------------------------------------------------------ 数据库
DB_NAME=followup
# 注意：超级用户名不能以 pg_ 开头
# （PostgreSQL 保留 pg_ 前缀给系统角色，用了会报
#   initdb: error: superuser name "pg_admin" is disallowed）
DB_SUPERUSER=followup_admin
DB_SUPERUSER_PASSWORD=CHANGE_ME_1

# 应用连接账号：必须是普通用户，行级安全策略依赖这一点，不要改成 pg_admin
DB_APP_USER=app_rw
DB_APP_PASSWORD=CHANGE_ME_2

# ------------------------------------------------------------------ 缓存
REDIS_PASSWORD=CHANGE_ME_3

# ------------------------------------------------------------------ 密钥（三个都要，缺一个容器会拒绝启动）
# ★ APP_CRYPTO_DATA_KEY 与 APP_CRYPTO_HASH_PEPPER 是加密患者手机号的钥匙，
#   一旦丢失，已经存进数据库的手机号就再也解不开了。必须抄在纸上单独保管。
APP_CRYPTO_DATA_KEY=CHANGE_ME_4
APP_CRYPTO_HASH_PEPPER=CHANGE_ME_5
APP_JWT_SECRET=CHANGE_ME_6
