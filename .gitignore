# ---------------------------------------------------------------- 密钥与配置
# 绝对不要提交：里面有数据库密码和数据加密密钥
.env
deploy/.env
*.env.local

# 备份文件与证书
deploy/backup/
deploy/nginx/certs/
*.dump
*.dump.sha256

# ---------------------------------------------------------------- 构建产物
target/
build/
dist/
dist-admin/
dist-patient/
out/
*.jar
*.war
*.class
node_modules/
.pnpm-store/

# ---------------------------------------------------------------- 部署与测试产物
# 补丁包与线上 www 副本（274 MB，只作为交付物保存，不进版本库）
dist-deploy/
# 压测、走查、截图等产物
output/
# 【注意】tools/.pipeline/ 是流水线台账（第几轮的唯一历史），**不要**忽略它

# ---------------------------------------------------------------- 安卓 App（C11）
# Gradle wrapper 的 jar 是构建必备文件：上面的 *.jar 会把它一起忽略掉，
# 少了它 CI 里 ./gradlew 直接报 "wrapper jar missing"（已实测）。
!frontend/android/gradle/wrapper/gradle-wrapper.jar
# 签名密钥绝不能进仓库：一旦提交，等于给全院 APK 发了一把万能钥匙
*.jks
*.keystore

# ---------------------------------------------------------------- IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project

# ---------------------------------------------------------------- 系统
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/

# ---------------------------------------------------------------- 临时目录
.tools/
.tmp/
tmp/
