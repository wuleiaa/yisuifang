<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 国内镜像配置（阿里云）。
  用法：mvn -s settings.xml clean package
  说明：不配置镜像时从 Maven 中央仓库拉依赖，国内速度较慢。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!--
    依赖仓库放在 D 盘，避免占用系统盘 C:。
    命令行里也会传 -Dmaven.repo.local，这里配置是为了 IDE 直接构建时同样生效。
  -->
  <localRepository>D:\devtools\m2repo</localRepository>

  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun Maven Central Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
